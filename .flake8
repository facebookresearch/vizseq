[flake8]
max-line-length = 100
extend-ignore =
    # line too long - too many to fix immediately
    E501,
    # whitespace before ':' - conflicts with black
    E203,
    # line break before binary operator - now preferred style
    W503,
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .eggs,
    venv,
    .venv,
per-file-ignores =
    # imported but unused - these are re-exports for public API
    __init__.py: F401
